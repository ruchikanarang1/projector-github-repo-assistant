# Projector AI Configuration

# Application
APP_NAME="Projector AI"
APP_VERSION="1.0.0"
DEBUG=True

# Database (Default: SQLite zero-configuration database)
# To use PostgreSQL: postgresql://username:password@localhost:5432/projector_db
DATABASE_URL="sqlite:///backend/storage/projector.db"

# LLM Providers (Gemini is recommended for massive context window & speed)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional: OpenAI API Key
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional: GitHub Personal Access Token (for private repos & rate-limit bypass)
GITHUB_TOKEN=""

# CORS Allowed Origins
CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000", "*"]'
